# Salin ke .env.local lalu isi kunci API Anda sendiri. Jangan commit berkas .env.local.
# Kunci dari Google AI Studio. Hanya dibaca di sisi server (api/tanya.ts, api/suluk-suara.ts & middleware Vite).
GEMINI_API_KEY=
# Model AI dikunci otomatis pada Gemini 3.8 Live (Unlimited RPM & Unlimited RPD di Google AI Studio).
GEMINI_MODEL=gemini-3.8-live
