{
  "name": "kelir",
  "private": true,
  "version": "1.0.0",
  "description": "Kelir: Ruang Pusaka 3D, Panggung Wayang Bayangan, dan Aksara Jawa Berbasis Sumber",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "playwright test --reporter=list",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/noto-sans-javanese": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.2",
    "gsap": "^3.15.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/three": "^0.187.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.8.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
